<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/img_logo"
                android:contentDescription="Wright Cut Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="WRIGHT CUT"
                android:textColor="@color/gold_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="12dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Home  -->
                <TextView
                    android:id="@+id/pillHome"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="Home"
                    android:textColor="@color/text_white" />

                <!--Services & Prices -->
                <TextView
                    android:id="@+id/pillServices"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_gold_btn"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Services &amp; Prices"
                    android:textColor="@color/bg_dark"
                    android:textStyle="bold" />

                <!-- Gallery -->
                <TextView
                    android:id="@+id/pillGallery"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Gallery"
                    android:textColor="@color/text_white" />

                <!-- Book Appointment-->
                <TextView
                    android:id="@+id/pillBook"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Book Appointment"
                    android:textColor="@color/text_white" />

                <!-- About Barbers-->
                <TextView
                    android:id="@+id/pillAbout"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="About Barbers"
                    android:textColor="@color/text_white" />

                <TextView
                    android:id="@+id/tvUserInitials"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/shape_status_badge"
                    android:gravity="center"
                    android:text="WC"
                    android:textColor="@color/gold_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Sign Out-->
                <TextView
                    android:id="@+id/pillSignOut"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Sign Out"
                    android:textColor="@color/error_red" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Price List -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFFICIAL PRICE LIST"
                    android:textColor="@color/gold_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Verified shop rates for haircuts, dyes, and trims."
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />

                <!-- Price List  Image -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ivPriceList"
                        android:layout_width="match_parent"
                        android:layout_height="440dp"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_price_list"
                        android:contentDescription="Official Price List" />
                </androidx.cardview.widget.CardView>

                <!-- BookButton -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnProceedToBook"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/shape_gold_btn"
                    android:text="Proceed to Book"
                    android:textColor="@color/bg_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnInstagram"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/gram"
                android:contentDescription="Instagram" />

            <ImageView
                android:id="@+id/btnFacebook"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/fb"
                android:contentDescription="Facebook" />

            <ImageView
                android:id="@+id/btnTikTok"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/tiktok"
                android:contentDescription="TikTok" />

            <ImageView
                android:id="@+id/btnTwitter"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/twitter"
                android:contentDescription="Twitter" />

            <ImageView
                android:id="@+id/btnWhatsApp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/app"
                android:contentDescription="WhatsApp" />
        </LinearLayout>

        <!-- Footer-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="© 2026 Wright Cut Barbershop. All Rights Reserved."
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>