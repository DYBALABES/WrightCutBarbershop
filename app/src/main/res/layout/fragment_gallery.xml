<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/img_logo"
                android:contentDescription="Wright Cut Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="WRIGHT CUT"
                android:textColor="@color/gold_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="12dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Home -->
                <TextView
                    android:id="@+id/pillHome"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="Home"
                    android:textColor="@color/text_white" />

                <!-- Services -->
                <TextView
                    android:id="@+id/pillServices"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Services &amp; Prices"
                    android:textColor="@color/text_white" />

                <!--Gallery  -->
                <TextView
                    android:id="@+id/pillGallery"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_gold_btn"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Gallery"
                    android:textColor="@color/bg_dark"
                    android:textStyle="bold" />

                <!-- Book Appointment -->
                <TextView
                    android:id="@+id/pillBook"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Book Appointment"
                    android:textColor="@color/text_white" />

                <!-- About Barbers -->
                <TextView
                    android:id="@+id/pillAbout"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="About Barbers"
                    android:textColor="@color/text_white" />

                <TextView
                    android:id="@+id/tvUserInitials"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/shape_status_badge"
                    android:gravity="center"
                    android:text="WC"
                    android:textColor="@color/gold_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pillSignOut"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Sign Out"
                    android:textColor="@color/error_red" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Our Work"
                android:textColor="@color/text_white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <View
                android:layout_width="54dp"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:background="@color/gold_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHaircut1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/haircut_3"
                            android:contentDescription="Mohawk and Black Dye" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:background="@color/text_white"
                            android:gravity="center"
                            android:text="MOHAWK &amp; BLACK DYE"
                            android:textColor="@color/bg_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHaircut3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/haircut_4"
                            android:contentDescription="Cut and Dye Plus Line" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:background="@color/text_white"
                            android:gravity="center"
                            android:text="CUT &amp; DYE PLUS LINE"
                            android:textColor="@color/bg_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHaircut5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/haircut_10"
                            android:contentDescription="Cut and Dye Colour" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:background="@color/text_white"
                            android:gravity="center"
                            android:text="CUT &amp; DYE COLOUR"
                            android:textColor="@color/bg_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHaircut7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/haircut_2"
                            android:contentDescription="Cut and Dye with Design" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:background="@color/text_white"
                            android:gravity="center"
                            android:text="CUT &amp; DYE WITH DESIGN"
                            android:textColor="@color/bg_dark"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHaircut9"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/haircut_6"
                            android:contentDescription="Cut and Dye Plus Beard" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:background="@color/text_white"
                            android:gravity="center"
                            android:text="CUT &amp; DYE + BEARD"
                            android:textColor="@color/bg_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHaircut2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/haircut_5"
                            android:contentDescription="Cut and Dye" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:background="@color/text_white"
                            android:gravity="center"
                            android:text="CUT &amp; DYE"
                            android:textColor="@color/bg_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHaircut4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/haircut_1"
                            android:contentDescription="Classic Taper" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:background="@color/text_white"
                            android:gravity="center"
                            android:text="CLASSIC TAPER"
                            android:textColor="@color/bg_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHaircut6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/haircut_7"
                            android:contentDescription="Mohawk Plus Dye" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:background="@color/text_white"
                            android:gravity="center"
                            android:text="MOHAWK + DYE"
                            android:textColor="@color/bg_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHaircut8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/haircut_8"
                            android:contentDescription="Bleach Plus Colour" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:background="@color/text_white"
                            android:gravity="center"
                            android:text="BLEACH + COLOUR"
                            android:textColor="@color/bg_dark"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBookNowBottom"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/shape_gold_btn"
            android:text="Book Now"
            android:textColor="@color/bg_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnInstagram"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/gram"
                android:contentDescription="Instagram" />

            <ImageView
                android:id="@+id/btnFacebook"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/fb"
                android:contentDescription="Facebook" />

            <ImageView
                android:id="@+id/btnTikTok"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/tiktok"
                android:contentDescription="TikTok" />

            <ImageView
                android:id="@+id/btnTwitter"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/twitter"
                android:contentDescription="Twitter" />

            <ImageView
                android:id="@+id/btnWhatsApp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/app"
                android:contentDescription="WhatsApp" />
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="© 2026 Wright Cut Barbershop. All Rights Reserved."
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>