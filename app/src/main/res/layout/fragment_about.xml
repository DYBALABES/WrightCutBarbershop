<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/img_logo"
                android:contentDescription="Wright Cut Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="WRIGHT CUT"
                android:textColor="@color/gold_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="12dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pillHome"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="Home"
                    android:textColor="@color/text_white" />

                <TextView
                    android:id="@+id/pillServices"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Services &amp; Prices"
                    android:textColor="@color/text_white" />

                <TextView
                    android:id="@+id/pillGallery"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Gallery"
                    android:textColor="@color/text_white" />

                <TextView
                    android:id="@+id/pillBook"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Book Appointment"
                    android:textColor="@color/text_white" />

                <TextView
                    android:id="@+id/pillAbout"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_gold_btn"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="About Barbers"
                    android:textColor="@color/bg_dark"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tvUserInitials"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/shape_status_badge"
                    android:gravity="center"
                    android:text="WC"
                    android:textColor="@color/gold_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Sign Out-->
                <TextView
                    android:id="@+id/pillSignOut"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Sign Out"
                    android:textColor="@color/error_red" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- OUR STORY -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OUR STORY"
                    android:textColor="@color/gold_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ivFounders"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_barbers"
                        android:contentDescription="Boikhutso Maswanganyi and Kagiso Maluleka" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Established in 2019 in Ga-Rankuwa Zone 2 before relocating to Zone 15 in 2022, Wright Cut Barbershop was founded by Boikhutso Maswanganyi and Kagiso Maluleka.\n\nBoth barbers are self-taught craftsmen who refined their expertise by studying master barbers across Africa, including experience working at Legends Barber before launching Wright Cut."
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!--FIND US ON GPS -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FIND US ON GPS"
                    android:textColor="@color/gold_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="📍 932 Monato Street, Ga-Rankuwa View, Zone 15, 0208, Gauteng"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />


                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="#121212"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🗺️ GPS Pin: Ga-Rankuwa View Zone 15"
                            android:textColor="@color/gold_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Near Bachana Mokwena Primary School"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Google Maps -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnOpenMaps"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/shape_gold_btn"
                    android:text="Open in Google Maps Navigation"
                    android:textColor="@color/bg_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnInstagram"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/gram"
                android:contentDescription="Instagram" />

            <ImageView
                android:id="@+id/btnFacebook"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/fb"
                android:contentDescription="Facebook" />

            <ImageView
                android:id="@+id/btnTikTok"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/tiktok"
                android:contentDescription="TikTok" />

            <ImageView
                android:id="@+id/btnTwitter"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/twitter"
                android:contentDescription="Twitter" />

            <ImageView
                android:id="@+id/btnWhatsApp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/app"
                android:contentDescription="WhatsApp" />
        </LinearLayout>

        <!-- Footer-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="© 2026 Wright Cut Barbershop. All Rights Reserved."
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>