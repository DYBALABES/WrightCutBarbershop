<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/img_logo"
                android:contentDescription="Wright Cut Logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/brand_header"
                android:textColor="@color/gold_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTopMenu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/shape_dark_card"
                android:gravity="center"
                android:text="⋮"
                android:textColor="@color/gold_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

       <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="12dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pillHome"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/shape_gold_btn"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:text="@string/nav_home"
                    android:textColor="@color/bg_dark"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pillServices"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/nav_services"
                    android:textColor="@color/text_white" />

                <TextView
                    android:id="@+id/pillGallery"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/nav_gallery"
                    android:textColor="@color/text_white" />

                <TextView
                    android:id="@+id/pillBook"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/nav_book"
                    android:textColor="@color/text_white" />

                <TextView
                    android:id="@+id/pillAbout"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/nav_about"
                    android:textColor="@color/text_white" />

                <TextView
                    android:id="@+id/pillAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/nav_admin"
                    android:textColor="@color/gold_primary"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvUserInitials"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/shape_status_badge"
                    android:gravity="center"
                    android:text="WC"
                    android:textColor="@color/gold_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pillSignOut"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/shape_dark_card"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="@string/nav_sign_out"
                    android:textColor="@color/error_red" />
            </LinearLayout>
        </HorizontalScrollView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:src="@drawable/img_logo"
                    android:contentDescription="Wright Cut Emblem" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/refining_style"
                    android:textColor="@color/gold_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/style_quote"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBookBarberSession"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/shape_gold_btn"
                    android:text="@string/btn_book_session"
                    android:textColor="@color/bg_dark"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Location Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/card_dark"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/location_hours_title"
                    android:textColor="@color/gold_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/shop_address"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/hours_mon_fri"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/hours_sat"
                    android:textColor="@color/text_white"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/shape_status_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tvLiveWaitBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/live_queue_wait"
                        android:textColor="@color/gold_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnInstagram"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/gram"
                android:contentDescription="Instagram" />

            <ImageView
                android:id="@+id/btnFacebook"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/fb"
                android:contentDescription="Facebook" />

            <ImageView
                android:id="@+id/btnTikTok"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/tiktok"
                android:contentDescription="TikTok" />

            <ImageView
                android:id="@+id/btnTwitter"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/twitter"
                android:contentDescription="Twitter" />

            <ImageView
                android:id="@+id/btnWhatsApp"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:src="@drawable/app"
                android:contentDescription="WhatsApp" />
        </LinearLayout>

        <!-- Footer-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/footer_copyright"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>